{
  "compilerOptions": {
    "allowJs": true,
    "experimentalDecorators": true,
    "noEmitOnError": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2015",
    "esModuleInterop": true,
    "lib": [
      "es2015",
      "dom"
    ],
    "strict": false,
    "types": [
      "jest",
      "office-js",
      "office-runtime",
      "cheerio"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "lib-amd"
  ]
}
